  {
    "id": "b500000000000007",
    "type": "function",
    "z": "b400000000000001",
    "name": "Prepare weather dashboard values",
    "func": "const p = msg.payload || {};\nconst current = p.current || {};\nconst rain = Array.isArray(p.rainfallForecast) ? p.rainfallForecast.filter((point) => typeof point.date === 'string' && Number.isFinite(point.rainfallMm)) : [];\nconst total = rain.reduce((sum, point) => sum + point.rainfallMm, 0);\nreturn [\n    { topic: 'air-temperature', payload: current.airTemperatureC },\n    { topic: 'wind-speed', payload: current.windSpeedKmh },\n    rain.length ? { topic: 'rainfall-forecast', action: 'replace', payload: rain.map((point) => ({ date: point.date, rainfallMm: point.rainfallMm })) } : null,\n    rain.length ? { topic: 'rainfall-total', payload: Number(total.toFixed(1)) } : null,\n    { payload: `## Smart Fishing Monitor\\n\\nLive weather forecasts and simulated sensor readings for **${String((p.location && p.location.name) || 'Configured location')}** (${Number(p.location && p.location.latitude).toFixed(4)}, ${Number(p.location && p.location.longitude).toFixed(4)}). Forecast data is model output; MQTT sensor values are generated by the local simulator.\\n\\nLocation details come from Compose variables \\`LOCATION_NAME\\`, \\`LOCATION_LATITUDE\\`, and \\`LOCATION_LONGITUDE\\` via the [weather normalization flow](/#flow/a100000000000001).` }\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 140,
    "wires": [
      [
        "b500000000000014",
        "b500000000000015"
      ],
      [
        "b500000000000016",
        "b500000000000017"
      ],
      [
        "b500000000000018"
      ],
      [
        "b500000000000019"
      ],
      [
        "b400000000000006"
      ]
    ]
  },
  {
    "id": "b500000000000008",
    "type": "function",
    "z": "b400000000000001",
    "name": "Prepare marine dashboard values",
    "func": "const current = (msg.payload && msg.payload.current) || {};\nconst value = (key) => Number.isFinite(current[key]) ? { topic: key, payload: current[key] } : null;\nreturn [value('waterTemperatureC'), value('seaLevelHeightMslM'), value('waveHeightM')];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
