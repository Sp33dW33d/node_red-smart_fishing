  {
    "id": "a10000000000000c",
    "type": "function",
    "z": "a100000000000001",
    "name": "Validate and normalize marine",
    "func": "if (msg.error) return null;\nconst data = msg.payload;\nif (msg.statusCode && (Number(msg.statusCode) < 200 || Number(msg.statusCode) >= 300)) {\n    node.error('Marine API returned HTTP ' + msg.statusCode, msg);\n    return null;\n}\nif (!data || typeof data !== 'object' || data.error || !data.hourly || !Array.isArray(data.hourly.time)) {\n    node.error('Marine API response is missing hourly forecast data', msg);\n    return null;\n}\nconst numeric = (value) => {\n    if (value === null || value === undefined || value === '') return null;\n    const result = Number(value);\n    return Number.isFinite(result) ? result : null;\n};\nconst nearest = (key) => {\n    const values = data.hourly[key];\n    if (!Array.isArray(values)) return null;\n    let best = null;\n    let bestDelta = Infinity;\n    const now = Date.now();\n    for (let i = 0; i < Math.min(values.length, data.hourly.time.length); i += 1) {\n        const value = numeric(values[i]);\n        const time = data.hourly.time[i];\n        const timestamp = typeof time === 'string' ? Date.parse(time) : NaN;\n        if (value === null || !Number.isFinite(timestamp)) continue;\n        const delta = Math.abs(timestamp - now);\n        if (delta < bestDelta) {\n            best = { value: value, time: time };\n            bestDelta = delta;\n        }\n    }\n    return best;\n};\nconst waterTemperature = nearest('sea_surface_temperature');\nconst seaLevel = nearest('sea_level_height_msl');\nconst waveHeight = nearest('wave_height');\nif (!waterTemperature && !seaLevel && !waveHeight) {\n    node.error('Marine API response contains no valid sea or wave measurements for this location', msg);\n    return null;\n}\nmsg.topic = 'environment/marine';\nmsg.payload = {\n    source: 'Open-Meteo Marine API',\n    status: waterTemperature && seaLevel ? 'OK' : 'PARTIAL',\n    fetchedAt: new Date().toISOString(),\n    location: { name: String(env.get('LOCATION_NAME') || 'Sassoon Dock, Mumbai'), latitude: Number(env.get('LOCATION_LATITUDE')), longitude: Number(env.get('LOCATION_LONGITUDE')) },\n    current: {\n        waterTemperatureC: waterTemperature ? waterTemperature.value : null,\n        seaLevelHeightMslM: seaLevel ? seaLevel.value : null,\n        waveHeightM: waveHeight ? waveHeight.value : null\n    },\n    sampleTimes: {\n        waterTemperature: waterTemperature ? waterTemperature.time : null,\n        seaLevel: seaLevel ? seaLevel.time : null,\n        waveHeight: waveHeight ? waveHeight.time : null\n    }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
