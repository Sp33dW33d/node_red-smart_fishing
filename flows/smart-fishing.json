  {
    "id": "a100000000000006",
    "type": "function",
    "z": "a100000000000001",
    "name": "Validate and normalize weather",
    "func": "if (msg.error) return null;\nconst data = msg.payload;\nif (msg.statusCode && (Number(msg.statusCode) < 200 || Number(msg.statusCode) >= 300)) {\n    node.error('Weather API returned HTTP ' + msg.statusCode, msg);\n    return null;\n}\nif (!data || typeof data !== 'object' || data.error || !data.current || !data.daily || !Array.isArray(data.daily.time) || !Array.isArray(data.daily.rain_sum)) {\n    node.error('Weather API response is missing current conditions or daily rain data', msg);\n    return null;\n}\nconst numeric = (value) => {\n    if (value === null || value === undefined || value === '') return null;\n    const result = Number(value);\n    return Number.isFinite(result) ? result : null;\n};\nconst temperature = numeric(data.current.temperature_2m);\nconst windSpeed = numeric(data.current.wind_speed_10m);\nif (temperature === null || windSpeed === null) {\n    node.error('Weather API response contains invalid temperature or wind speed', msg);\n    return null;\n}\nconst rainfallForecast = [];\nconst count = Math.min(5, data.daily.time.length, data.daily.rain_sum.length);\nfor (let i = 0; i < count; i += 1) {\n    const date = data.daily.time[i];\n    const rain = numeric(data.daily.rain_sum[i]);\n    if (typeof date === 'string' && !Number.isNaN(Date.parse(date)) && rain !== null && rain >= 0) {\n        rainfallForecast.push({ date: date, rainfallMm: rain });\n    }\n}\nif (rainfallForecast.length === 0) {\n    node.error('Weather API response contains no valid daily rainfall values', msg);\n    return null;\n}\nmsg.topic = 'environment/weather';\nmsg.payload = {\n    source: 'Open-Meteo Forecast API',\n    status: 'OK',\n    fetchedAt: new Date().toISOString(),\n    observedAt: typeof data.current.time === 'string' ? data.current.time : null,\n    location: { name: String(env.get('LOCATION_NAME') || 'Sassoon Dock, Mumbai'), latitude: Number(env.get('LOCATION_LATITUDE')), longitude: Number(env.get('LOCATION_LONGITUDE')) },\n    current: { airTemperatureC: temperature, windSpeedKmh: windSpeed },\n    rainfallForecast: rainfallForecast\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
