    "id": "a100000000000015",
    "type": "function",
    "z": "a100000000000001",
    "name": "Validate and normalize telemetry",
    "func": "msg.source = 'mqtt';\nconst data = msg.payload;\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n    node.error('MQTT telemetry payload must be a JSON object', msg);\n    return null;\n}\nconst deviceId = typeof data.device_id === 'string' ? data.device_id.trim() : '';\nconst timestamp = typeof data.timestamp === 'string' ? Date.parse(data.timestamp) : NaN;\nconst finiteNumber = (value) => typeof value === 'number' && Number.isFinite(value);\nif (!deviceId || !Number.isFinite(timestamp)) {\n    node.error('MQTT telemetry requires a device_id and valid ISO timestamp', msg);\n    return null;\n}\nif (!finiteNumber(data.water_temperature_c) || !finiteNumber(data.water_level_m) || !finiteNumber(data.battery_voltage_v) || !Number.isInteger(data.catch_count) || data.catch_count < 0) {\n    node.error('MQTT telemetry contains missing or invalid sensor values', msg);\n    return null;\n}\nmsg.topic = 'sensor/telemetry/' + deviceId;\nmsg.payload = {\n    source: 'MQTT sensor telemetry',\n    status: 'OK',\n    deviceId: deviceId,\n    observedAt: new Date(timestamp).toISOString(),\n    receivedAt: new Date().toISOString(),\n    waterTemperatureC: data.water_temperature_c,\n    waterLevelM: data.water_level_m,\n    catchCount: data.catch_count,\n    batteryVoltageV: data.battery_voltage_v\n};\nreturn msg;",
