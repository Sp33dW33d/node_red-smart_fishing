  {
    "id": "b500000000000009",
    "type": "function",
    "z": "b400000000000001",
    "name": "Prepare telemetry dashboard values",
    "func": "const p = msg.payload || {};\nconst time = Date.parse(p.observedAt);\nconst scalar = (topic, value) => Number.isFinite(value) ? { topic, payload: value } : null;\nconst point = (topic, value) => Number.isFinite(value) && Number.isFinite(time) ? { topic, payload: { time, value } } : null;\nreturn [\n    scalar('sensor-water-temperature', p.waterTemperatureC),\n    point('sensor-water-temperature', p.waterTemperatureC),\n    scalar('sensor-water-level', p.waterLevelM),\n    point('sensor-water-level', p.waterLevelM),\n    scalar('sensor-catch-count', p.catchCount),\n    scalar('sensor-battery-voltage', p.batteryVoltageV)\n];",
    "outputs": 6,
    "timeout": 0,
