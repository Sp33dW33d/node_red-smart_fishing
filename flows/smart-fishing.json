    "type": "function",
    "z": "a100000000000001",
    "name": "Build weather request",
    "func": "const base = env.get('WEATHER_API_URL');\nconst latRaw = env.get('LOCATION_LATITUDE');\nconst lonRaw = env.get('LOCATION_LONGITUDE');\nconst latitude = Number(latRaw);\nconst longitude = Number(lonRaw);\nif (!base || latRaw === undefined || lonRaw === undefined || String(latRaw).trim() === '' || String(lonRaw).trim() === '' || !Number.isFinite(latitude) || !Number.isFinite(longitude) || latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180) {\n    node.error('Weather API URL or location coordinates are invalid', msg);\n    return null;\n}\nconst params = {\n    latitude: latitude,\n    longitude: longitude,\n    current: 'temperature_2m,wind_speed_10m',\n    daily: 'rain_sum',\n    forecast_days: 5,\n    timezone: 'auto',\n    temperature_unit: 'celsius',\n    wind_speed_unit: 'kmh'\n};\nconst query = Object.keys(params).map((key) => encodeURIComponent(key) + '=' + encodeURIComponent(params[key])).join('&');\nmsg.source = 'weather';\nmsg.url = base + (base.indexOf('?') === -1 ? '?' : '&') + query;\nreturn msg;",
