# Local environment values and credentials
.env

# Node-RED runtime state and generated credential files
node-red/.config.*
node-red/flows_cred.json
node-red/lib/
node-red/node_modules/
node-red/.npm/
node-red/.sessions.json

# Mosquitto runtime data is stored in a Docker named volume; keep any local overrides out of Git
mosquitto/data/
mosquitto/log/

# Local Python environments and bytecode
.venv/
__pycache__/
*.py[cod]
