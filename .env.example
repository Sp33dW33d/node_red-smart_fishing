# Copy this file to .env and replace the credential secret before starting.
PORT=1880
TZ=Asia/Calcutta
NODE_RED_CREDENTIAL_SECRET=replace_with_a_long_random_secret
# Use IPv4 for outbound HTTPS when the Docker host has no working IPv6 route.
NODE_RED_FORCE_IPV4=true

# Sample location: Sassoon Dock, Colaba, Mumbai. Update the name and both coordinates together.
LOCATION_NAME=Sassoon Dock, Mumbai
LOCATION_LATITUDE=18.9110
LOCATION_LONGITUDE=72.8253

# Open-Meteo endpoints do not require an API key for this non-commercial project.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
HISTORY_CACHE_INTERVAL_SECONDS=3600

# Local MQTT broker (anonymous access; host port is bound to loopback only)
MQTT_PORT=1883
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=smartfishing
MQTT_DEVICE_ID=demo-01
MQTT_CONDITIONS_TOPIC=smartfishing/conditions
