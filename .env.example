# Copy this file to .env and replace the credential secret before starting.
PORT=1880
TZ=Asia/Calcutta
NODE_RED_CREDENTIAL_SECRET=replace_with_a_long_random_secret

# Weather API configuration
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# MQTT settings are used when the broker is added in a later implementation phase.
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=smartfishing
